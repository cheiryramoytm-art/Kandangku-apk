[{"id": "a1", "title": "Adegan 1 · Kandang", "emoji": "🏠", "kind": "dialog", "audio": "audio/a1.m4a", "duration": 80.07, "lines": [{"who": "Narator", "text": "Di kota kecil bernama Betlehem, ada sebuah kandang. Di kandang itu tinggal dua ekor domba: Embe dan adiknya, Embi.", "cue": "01", "t": 1.16}, {"who": "Narator", "text": "Kandang itu kecil, bau, dan gelap. Tapi buat Embe, kandang itu istananya. Apalagi palungannya, tempat makan kesayangannya.", "cue": "01", "t": 11.38}, {"who": "Embe", "text": "Kita Punya...", "cue": "01", "t": 22.26}, {"who": "Narator", "text": "Malam itu, kota Betlehem ramai sekali. Semua penginapan penuh.", "cue": "01", "t": 24.1}, {"who": "Embe", "text": "Biar jo nda penting sih itu info.", "cue": "01", "t": 30.72}, {"who": "Narator", "text": "Tapi malam itu, ada yang datang. Yusuf dan istrinya, Maria, yang sedang mengandung.", "cue": "02", "t": null, "skip": true}, {"who": "Yusuf", "text": "Maria, tu kosong cuman ada ini kandang", "cue": "02", "t": 37.94}, {"who": "Maria", "text": "Nda apa apa, torang istirahat disini jo", "cue": "02", "t": 42.18}, {"who": "Embe", "text": "Mbeeek?!", "cue": "02", "t": 46.76}, {"who": "Embi", "text": "Kak, ada orang!", "cue": "02", "t": 48.14}, {"who": "Embe", "text": "Heh kita pe kandang!", "cue": "02", "t": 50.76}, {"who": "Maria", "text": "Domba-domba imyut... kami menumpang nehh.", "cue": "02", "t": 54.44}, {"who": "Embi", "text": "Kak, imut kata torang!", "cue": "02", "t": 58.44}, {"who": "Embe", "text": "Oh jelas imut... TETAP NEMBOLEH!", "cue": "02", "t": 60.76}], "estimated": false}, {"id": "l1", "title": "Lagu 1 · Ini Kandangku!", "emoji": "🎵", "kind": "song", "audio": "audio/l1.m4a", "duration": 72.86, "lines": [{"who": "Embi", "text": "Kak! Dorang mo tidor disini!", "spoken": true, "t": 0.76}, {"who": "Embe", "text": "hah?! Pa Kita Pe Kandang?!", "spoken": true, "t": 4.28}, {"who": "Embi", "text": "Ini kandang istananya", "part": "Verse 1", "t": 7.98}, {"who": "Embi", "text": "Jerami kasurnya", "part": "Verse 1", "t": 11.08}, {"who": "Embi", "text": "Ada bintang di atapnya", "part": "Verse 1", "t": 14.42}, {"who": "Embi", "text": "Palungan miliknya", "part": "Verse 1", "t": 17.58}, {"who": "Embi", "text": "Malam ini datang tamu", "part": "Verse 1", "t": 20.78}, {"who": "Embi", "text": "Masuk ke kandangnya!", "part": "Verse 1", "t": 24.08}, {"who": "Embe", "text": "O, pergi dari kandangku, kandangku, mbeeek!", "part": "Reff", "t": 27.08}, {"who": "Embe", "text": "O, pergi dari kandangku!", "part": "Reff", "t": 33.48}, {"who": "Embi", "text": "Kak, jerami kita dipakai!", "spoken": true, "t": null, "skip": true}, {"who": "Embe", "text": "Huh! Nyebelin!", "spoken": true, "t": 38.82}, {"who": "Embi", "text": "Jerami diacak-acak", "part": "Verse 2", "t": 40.3}, {"who": "Embi", "text": "Jadi berantakan", "part": "Verse 2", "t": 43.52}, {"who": "Embi", "text": "Palungan tempat makannya", "part": "Verse 2", "t": 46.7}, {"who": "Embi", "text": "Jangan sembarangan", "part": "Verse 2", "t": 49.94}, {"who": "Embi", "text": "Kakak tidur di mana dong?", "part": "Verse 2", "t": 53.08}, {"who": "Embi", "text": "Masa di luaran?", "part": "Verse 2", "t": 56.34}, {"who": "Embe", "text": "O, pergi dari kandangku, kandangku, mbeeek!", "part": "Reff", "t": 59.04}, {"who": "Embe", "text": "O, pergi dari kandangku!", "part": "Reff", "t": 65.42}, {"who": "Embi", "text": "Kak... itu ibu dapa lia lelah kiok.", "spoken": true, "t": null, "skip": true}, {"who": "Embe", "text": "Biar sana!Emang gw pikirin", "spoken": true, "t": null, "skip": true}, {"who": "Embe", "text": "O, pergi dari kandangku, kandangku, mbeeek!", "part": "Reff", "t": null, "skip": true}, {"who": "Embe", "text": "O, pergi dari kandangku!", "part": "Reff", "t": null, "skip": true}, {"who": "Embe", "text": "Kita tae somo pigi!", "spoken": true, "t": null, "skip": true}, {"who": "Embi", "text": "Kak, tunggu!", "spoken": true, "t": null, "skip": true}], "estimated": false}, {"id": "a2", "title": "Adegan 2 · Kabur dan Dicari", "emoji": "🌙", "kind": "dialog", "audio": "audio/a2.m4a", "duration": 115.4, "lines": [{"who": "Narator", "text": "Embe pergi dari kandang. Embi ikut menyusul kakaknya. Malam itu dingin dan gelap sekali.", "cue": "04", "t": 1.88}, {"who": "Embi", "text": "Kak, dingin...", "cue": "04", "t": 12.88}, {"who": "Embe", "text": "Kita nda tako lai... tako sadiki siii hehe.", "cue": "04", "t": 14.88}, {"who": "Embe", "text": "Mbeek! Sapa itu?!", "cue": "04", "t": 23.24}, {"who": "Narator", "text": "Karena tidak hati-hati, kaki Embe tersangkut semak berduri.", "cue": "04", "t": 25.84}, {"who": "Embe", "text": "Tolong! Kita pe kaki tagate!", "cue": "04", "t": 31.18}, {"who": "Embi", "text": "Kak Embe!", "cue": "04", "t": 33.94}, {"who": "Embe", "text": "Kita suka mo pulang...", "cue": "04", "t": 36.78}, {"who": "Narator", "text": "Tidak jauh dari situ, ada gembala yang menjaga domba di padang: Pak Yakob, Timo, dan dua domba mereka, Bolu dan Cilik.", "cue": "05", "t": 40.56}, {"who": "Timo", "text": "Pak, Rupa ada domba pe suara!", "cue": "05", "t": 51.46}, {"who": "Pak Yakob", "text": "Hah? Lengkap sih torang p domba, Timo", "cue": "05", "t": 54.78}, {"who": "Cilik", "text": "Adoh kage serigala au...", "cue": "05", "t": 59.56}, {"who": "Bolu", "text": "Heh, Srigala bukang au, mar AAAUUUUUUU", "cue": "05", "t": 62.86}, {"who": "Timo", "text": "Tunggu kita pi lia!", "cue": "05", "t": 68.94}, {"who": "Timo", "text": "Ngoni sapa pe domba?", "cue": "05", "t": 73.5}, {"who": "Embe", "text": "Mbeek...", "cue": "05", "t": 75.12}, {"who": "Pak Yakob", "text": "Ehh bukang torang p domba itu Timo.", "cue": "05", "t": 78.48}, {"who": "Timo", "text": "Kasiang kalo mo se tinggal pak.", "cue": "05", "t": 82.28}, {"who": "Pak Yakob", "text": "Betul Timo. Gembala yang baik menolong domba yang tersesat. Domba siapa pun.", "cue": "05", "t": 85.56}, {"who": "Narator", "text": "Malam itu, Embe ditolong. Padahal dia sendiri yang pergi.", "cue": "05", "t": 93.14}, {"who": "Embe", "text": "Dorang ja tolong p kita?", "cue": "05", "t": 98.74}, {"who": "Bolu", "text": "Woy kita bolu, ngoni sapa?", "cue": "05", "t": 101.58}, {"who": "Cilik", "text": "Kita Cilik…", "cue": "05", "t": 105.14}, {"who": "Embi", "text": "Kita Embi! Ini kita pe kakak...", "cue": "05", "t": 107.7}, {"who": "Embe", "text": "...Embe.", "cue": "05", "t": 110.44}], "estimated": false}, {"id": "a3", "title": "Adegan 3 · Malaikat Datang", "emoji": "✨", "kind": "dialog", "audio": "audio/a3.m4a", "duration": 8.59, "lines": [{"who": "Narator", "text": "Tiba-tiba, langit menjadi terang sekali. Malaikat Tuhan datang!", "cue": "06", "t": 0.64}], "estimated": false}, {"id": "l2", "title": "Lagu 2 · Kabar Sukacita", "emoji": "🎵", "kind": "song", "audio": "audio/l2.m4a", "duration": 173.94, "lines": [{"who": "Malaikat", "text": "Gembala, jangan takut", "part": "Putaran 1 — kabar dari malaikat", "t": 17.3}, {"who": "Cilik", "text": "Telat, aku pun takut!", "part": "Putaran 1 — kabar dari malaikat", "t": 21.78}, {"who": "Malaikat", "text": "Ada kabar gembira", "part": "Putaran 1 — kabar dari malaikat", "t": 26.36}, {"who": "Malaikat Kecil", "text": "Untuk semua bangsa", "part": "Putaran 1 — kabar dari malaikat", "t": 30.84}, {"who": "Malaikat", "text": "Malam ini t'lah lahir", "part": "Putaran 1 — kabar dari malaikat", "t": 35.2}, {"who": "Malaikat", "text": "Juruselamat hadir", "part": "Putaran 1 — kabar dari malaikat", "t": 41.2}, {"who": "Malaikat Kecil", "text": "Ini dia tandanya", "part": "Putaran 1 — kabar dari malaikat", "t": 44.36}, {"who": "Malaikat", "text": "Bayi dalam palungan", "part": "Putaran 1 — kabar dari malaikat", "t": 48.74}, {"who": "Malaikat & Malaikat Kecil", "text": "Dengar, sorga bernyanyi", "part": "Reff — Malaikat & Malaikat Kecil", "t": 53.24}, {"who": "Malaikat & Malaikat Kecil", "text": "Lahir raja yang suci", "part": "Reff — Malaikat & Malaikat Kecil", "t": 57.76}, {"who": "Embe", "text": "Palungan di kandangku?", "part": "Putaran 2 — semua bereaksi", "t": 71.26}, {"who": "Embi", "text": "Itu tempat makanmu!", "part": "Putaran 2 — semua bereaksi", "t": 75.84}, {"who": "Pak Yakob", "text": "Kabar yang sungguh besar", "part": "Putaran 2 — semua bereaksi", "t": 80.24}, {"who": "Timo", "text": "Hati kami berdebar", "part": "Putaran 2 — semua bereaksi", "t": 84.7}, {"who": "Bolu & Cilik", "text": "Domba boleh ikut, kan?", "part": "Putaran 2 — semua bereaksi", "t": 89.26}, {"who": "Malaikat Kecil", "text": "Semua boleh datang!", "part": "Putaran 2 — semua bereaksi", "t": 93.74}, {"who": "Embi", "text": "Kak, jangan gengsi lagi!", "part": "Putaran 2 — semua bereaksi", "t": 98.24}, {"who": "Embe", "text": "Ya udah... aku ikut", "part": "Putaran 2 — semua bereaksi", "t": 103.54}, {"who": "Semua", "text": "Dengar, sorga bernyanyi", "part": "Reff — Semua", "t": 107.26}, {"who": "Semua", "text": "Lahir raja yang suci", "part": "Reff — Semua", "t": 111.72}, {"who": "Malaikat & Malaikat Kecil", "text": "Puji allah di sorga", "part": "Putaran 3 — pujian sorga, lalu berangkat", "t": 125.22}, {"who": "Malaikat & Malaikat Kecil", "text": "Damai bagi dunia", "part": "Putaran 3 — pujian sorga, lalu berangkat", "t": 129.78}, {"who": "Pak Yakob", "text": "Mari, kita ke sana", "part": "Putaran 3 — pujian sorga, lalu berangkat", "t": 134.24}, {"who": "Timo", "text": "Lihat raja mulia", "part": "Putaran 3 — pujian sorga, lalu berangkat", "t": 138.78}, {"who": "Bolu", "text": "Aku bawa hadiah", "part": "Putaran 3 — pujian sorga, lalu berangkat", "t": 143.36}, {"who": "Cilik", "text": "Buat sang bayi raja!", "part": "Putaran 3 — pujian sorga, lalu berangkat", "t": 147.8}, {"who": "Malaikat Kecil", "text": "Hati-hati di jalan!", "part": "Putaran 3 — pujian sorga, lalu berangkat", "t": 152.84}, {"who": "Semua", "text": "Kristus lahir, betlehem!", "part": "Putaran 3 — pujian sorga, lalu berangkat", "t": 156.2}, {"who": "Semua", "text": "Dengar, sorga bernyanyi", "part": "Reff — Semua", "t": 161.24}, {"who": "Semua", "text": "Lahir raja yang suci", "part": "Reff — Semua", "t": 166.98}, {"who": "Semua", "text": "Haleluya!", "spoken": true, "t": 171.0}], "estimated": false}, {"id": "a4", "title": "Adegan 4 · Di Palungan", "emoji": "⭐", "kind": "dialog", "audio": "audio/a4.m4a", "duration": 39.31, "lines": [{"who": "Narator", "text": "Tapi di Betlehem, kandangnya ada banyak sekali.", "cue": "08", "t": 1.18}, {"who": "Timo", "text": "Kandang yang mana, Pak?", "cue": "08", "t": 5.8}, {"who": "Embe", "text": "Marijo, Kita tau!", "cue": "08", "t": 7.86}, {"who": "Timo", "text": "Keknya itu domba tahu depe jalan!", "cue": "08", "t": 10.84}, {"who": "Narator", "text": "Embe yang tadi marah, sekarang malah menunjukkan jalan ke kandangnya sendiri.", "cue": "08", "t": 14.74}, {"who": "Narator", "text": "Dan di sana, di palungan tempat makan Embe, ada seorang bayi. Dialah Yesus, Sang Raja.", "cue": "08", "t": 20.94}, {"who": "Maria", "text": "Kamu kembali domba imut.", "cue": "08", "t": 30.12}, {"who": "Embe", "text": "Maaf ya... tadi aku galak.", "cue": "08", "t": 33.46}], "estimated": false}, {"id": "l3", "title": "Lagu 3 · Tidurlah, Raja Kecil", "emoji": "🎵", "kind": "song", "audio": "audio/l3.m4a", "duration": 80.4, "lines": [{"who": "Maria", "text": "Lentera di kandang", "part": "Verse", "t": 3.02}, {"who": "Maria", "text": "Sinar lembut menyapa", "part": "Verse", "t": 9.56}, {"who": "Maria", "text": "Jerami yang hangat", "part": "Verse", "t": 15.94}, {"who": "Maria", "text": "Bayiku tidur di sana", "part": "Verse", "t": 22.48}, {"who": "Embi", "text": "Marah hilang", "part": "Bridge", "t": 29.76}, {"who": "Embi", "text": "Hati tenang", "part": "Bridge", "t": 33.0}, {"who": "Embi", "text": "Kakak kini tersenyum", "part": "Bridge", "t": 36.28}, {"who": "Maria & Embi", "text": "Malam yang 'kan kukenang", "part": "Reff", "t": 42.18}, {"who": "Maria & Embi", "text": "Damai di sekitarku", "part": "Reff", "t": 49.04}, {"who": "Maria & Embi", "text": "Selamanya kukenang", "part": "Reff", "t": 55.0}, {"who": "Maria & Embi", "text": "Semua lagu", "part": "Reff", "t": 62.56}, {"who": "Maria & Embi", "text": "Semua kasih", "part": "Reff", "t": 65.52}, {"who": "Maria, Embi & Embe", "text": "Semua di sini bersamaku", "part": "Penutup", "t": 68.82}], "estimated": false}, {"id": "a5", "title": "Adegan 5 · Pesan Embe", "emoji": "💛", "kind": "dialog", "audio": "audio/a5.m4a", "duration": 30.31, "lines": [{"who": "Narator", "text": "Malam itu, Embe belajar sesuatu. Kandangnya memang kecil, bau, dan berantakan. Tapi Tuhan Yesus mau lahir di sana.", "cue": "10", "t": 0.46}, {"who": "Narator", "text": "Tuhan tidak mencari tempat yang bagus. Tuhan mencari hati yang mau terbuka.", "cue": "10", "t": 10.44}, {"who": "Embe", "text": "Kita p kandang memang kecil... mar cukup for Raja.", "cue": "10", "t": 16.86}, {"who": "Narator", "text": "Bagaimana dengan hatimu? Adakah tempat untuk Tuhan Yesus?", "cue": "10", "t": 21.36}], "estimated": false}, {"id": "l4", "title": "Lagu 4 · Ada Tempat untuk-Mu", "emoji": "🎵", "kind": "song", "audio": null, "duration": 0, "lines": [{"who": "Embe & Embi", "text": "Bukan istana, bukan rumah megah", "part": "Bait"}, {"who": "Embe & Embi", "text": "Hanya kandang kecil di betlehem", "part": "Bait"}, {"who": "Pak Yakob & Timo", "text": "Hatiku pun kotor dan berantakan", "part": "Bait"}, {"who": "Pak Yakob & Timo", "text": "Tapi kau mau datang dan tinggal", "part": "Bait"}, {"who": "Maria & Yusuf", "text": "Semua pintu tertutup dan penuh", "part": "Bait"}, {"who": "Maria & Yusuf", "text": "Kandang kecil membuka pintunya", "part": "Bait"}, {"who": "Semua", "text": "Ada tempat", "part": "Klimaks"}, {"who": "Semua", "text": "Untuk-mu di hatiku", "part": "Klimaks"}, {"who": "Semua", "text": "Ya yesusku", "part": "Klimaks"}, {"who": "Semua", "text": "Raja di hatiku", "part": "Klimaks"}, {"who": "Semua", "text": "Ya yesusku", "part": "Klimaks"}, {"who": "Semua", "text": "Tempatku untuk-mu", "part": "Klimaks"}], "estimated": true}]